KAFKA_BROKERS=localhost:9092,localhost:9093,localhost:9094
# Topología de los tópicos (C10: 3 particiones y 3 réplicas)
KAFKA_PARTITIONS=3
KAFKA_REPLICATION_FACTOR=3
KAFKA_MIN_INSYNC_REPLICAS=2
# Reintentos del consumidor: 3 intentos, espera 1 s y 2 s entre ellos
CONSUMER_MAX_ATTEMPTS=3
CONSUMER_RETRY_BASE_MS=1000
# Admin REST de Kafka y API del monitor
ADMIN_PORT=3000
# Carpeta de las bases SQLite de report y audit
DATA_DIR=./data
