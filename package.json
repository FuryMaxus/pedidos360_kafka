{
  "name": "pedidos360-kafka",
  "version": "2.0.0",
  "private": true,
  "description": "Pedidos360: streaming de eventos de pedidos con Kafka, consumidores report y audit, DLT y administrador REST",
  "engines": { "node": ">=22.13.0" },
  "scripts": {
    "topics": "node --env-file-if-exists=.env --disable-warning=TimeoutNegativeWarning admin/setup.js",
    "admin": "node --env-file-if-exists=.env --disable-warning=TimeoutNegativeWarning admin/server.js",
    "producer": "node --env-file-if-exists=.env --disable-warning=TimeoutNegativeWarning bridge/producer.js",
    "report": "node --env-file-if-exists=.env --disable-warning=TimeoutNegativeWarning report/consumer.js",
    "audit": "node --env-file-if-exists=.env --disable-warning=TimeoutNegativeWarning audit/consumer.js",
    "errores": "node --env-file-if-exists=.env --disable-warning=TimeoutNegativeWarning scripts/errores.js",
    "dlt": "node --env-file-if-exists=.env --disable-warning=TimeoutNegativeWarning scripts/dlt.js",
    "kpis": "node --env-file-if-exists=.env --disable-warning=TimeoutNegativeWarning scripts/kpis.js",
    "timeline": "node --env-file-if-exists=.env --disable-warning=TimeoutNegativeWarning scripts/timeline.js"
  },
  "dependencies": {
    "express": "^5.1.0",
    "kafkajs": "^2.2.4"
  }
}
